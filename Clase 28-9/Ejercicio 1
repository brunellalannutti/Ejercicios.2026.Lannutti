#include <stdio.h>

int main() {
    int matriz[3][2];
    int i, j;

    // Cargar datos
    for(i = 0; i < 3; i++) {
        for(j = 0; j < 2; j++) {
            printf("Ingrese un valor para [%d][%d]: ", i, j);
            scanf("%d", &matriz[i][j]);
        }
    }

    // Mostrar datos
    printf("\nMatriz:\n");
    for(i = 0; i < 3; i++) {
        for(j = 0; j < 2; j++) {
            printf("%d ", matriz[i][j]);
        }
        printf("\n");
    }

    return 0;
}
