#include <stdio.h>

int main() {
    int tabla[4][4] = {
        {0, 0, 0, 0},
        {0, 1, 0, 1},
        {1, 0, 0, 1},
        {1, 1, 1, 1}
    };

    int i;

    printf("A B | AND OR\n");
    printf("------------\n");

    for(i = 0; i < 4; i++) {
        printf("%d %d |  %d   %d\n",
               tabla[i][0],
               tabla[i][1],
               tabla[i][2],
               tabla[i][3]);
    }

    return 0;
}
