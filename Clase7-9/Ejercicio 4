#include <stdio.h>

void compararVectores(int v1[], int v2[], int tam) {
    int i;

    for(i = 0; i < tam; i++) {
        if(v1[i] > v2[i]) {
            printf("Posicion %d: Mayor = %d (Vector 1)\n", i, v1[i]);
        } else if(v2[i] > v1[i]) {
            printf("Posicion %d: Mayor = %d (Vector 2)\n", i, v2[i]);
        } else {
            printf("Posicion %d: Ambos tienen el mismo valor (%d)\n", i, v1[i]);
        }
    }
}

int main() {
    int vector1[5];
    int vector2[5];
    int i;

    printf("Carga del Vector 1\n");
    for(i = 0; i < 5; i++) {
        printf("Ingrese valor %d: ", i);
        scanf("%d", &vector1[i]);
    }

    printf("\nCarga del Vector 2\n");
    for(i = 0; i < 5; i++) {
        printf("Ingrese valor %d: ", i);
        scanf("%d", &vector2[i]);
    }

    printf("\nComparacion:\n");
    compararVectores(vector1, vector2, 5);

    return 0;
}
